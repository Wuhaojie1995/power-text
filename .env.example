# 环境变量模板：复制为 .env（开发）或 .envProd（生产）后填写真实值。
# 真正的 .env / .envProd 已被 .gitignore 忽略，不会被提交。

# ---------------- 前端构建用（VITE_ 前缀会被打进产物，不要放密钥） ----------------
VITE_ENVIRONMENT="development"
VITE_TITLE="Agent"
VITE_CODE="car"
VITE_PORT="8001"
VITE_OUTPUT="power-development"
VITE_BASENAME=""
VITE_SERVER="https://dev.p3china.com:7700/nbg.web.dev/api"
VITE_STATIC_SRC="https://dev.p3china.com:7700/nbg.web.dev/resources"
VITE_MICRO_ENTRY="https://dev.p3china.com:7700/nbg.web.dev"
VITE_MICRO_WINDOW_ENTRY="https://dev.p3china.com:7700/nbg.web.dev"

# Mastra 服务地址。开发环境用本地 4112；
# 生产环境请填真实部署地址，留空则前端自动改用「当前页面同源」。
VITE_MASTRA_API_URL="http://localhost:4112"

# ---------------- Mastra 服务端用（Node 环境，可以放密钥） ----------------
# 模型服务密钥：当前用火山方舟的豆包，读 ANTHROPIC_AUTH_TOKEN 或 ARK_API_KEY
ANTHROPIC_AUTH_TOKEN=your-ark-api-key
ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/compatible
ARK_API_KEY=your-ark-api-key

# 调用业务后台接口的 Authorization（patrol-constants.ts 读取）
# 不填会回退到代码里写死的那个值，仅供本地调试，正式环境务必配置
PATROL_API_TOKEN=your-patrol-api-token

# 内部巡视系统接口基址，不填时用代码内置的开发环境地址
# PATROL_INTERNAL_API_BASE=https://dev.p3china.com:7700/nbg.app.dev/api

# 可选：远程 Turso 数据库；不填则用本地 mastra.db
# TURSO_DATABASE_URL=libsql://your-database-url
# TURSO_AUTH_TOKEN=your-turso-auth-token

# 可选：可观测性数据上报 Mastra Platform
# MASTRA_PLATFORM_ACCESS_TOKEN=your-mastra-platform-access-token
# MASTRA_PROJECT_ID=your-mastra-project-id

# 可选：阿里云语音（当前未启用）
# ALIYUN_NLS_APPKEY=your-aliyun-nls-appkey
# ALIYUN_ACCESS_KEY_ID=your-aliyun-accesskey-id
# ALIYUN_ACCESS_KEY_SECRET=your-aliyun-accesskey-secret
# ALIYUN_NLS_ENDPOINT=nls-gateway-cn-shanghai.aliyuncs.com
